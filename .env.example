# AR Resolve environment configuration. Copy to .env (gitignored) and fill in. Never commit real values.

# ---- Production hardening workstream (ADR 0090, server/config.ts) ----
# Deployment kind: synthetic (default, demo data, dev login) | staging | production.
# staging/production refuse to start unless every value marked REQUIRED below is set and valid.
AR_ENV=production
# Rollout stage used by the connector and PHI gates (REQUIRED outside synthetic): shadow | assisted_live
AR_ENVIRONMENT=shadow
PORT=8080
# REQUIRED: absolute path on a persistent volume
AR_DB=/data/ar-resolve.db
# REQUIRED: the https origin users reach (behind your TLS reverse proxy)
AR_PUBLIC_BASE_URL=https://ar.example.com
# REQUIRED: browser origins allowed to call the API (comma-separated https origins)
AR_ALLOWED_ORIGINS=https://ar.example.com
# Number of trusted reverse proxies in front of the app (for client IPs in rate limiting); 0 = none
AR_TRUST_PROXY_HOPS=1
# REQUIRED: at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AR_SESSION_SECRET=
AR_SESSION_TTL_HOURS=10
AR_SESSION_IDLE_MINUTES=30
# REQUIRED: OpenID Connect (Okta, Microsoft Entra ID, Google Workspace). Register redirect URI
# https://<host>/api/auth/callback with the IdP; the issuer must match the IdP discovery document exactly.
AR_OIDC_ISSUER=
AR_OIDC_CLIENT_ID=
AR_OIDC_CLIENT_SECRET=
# Optional: defaults to AR_PUBLIC_BASE_URL + /api/auth/callback
AR_OIDC_REDIRECT_URI=
AR_OIDC_SCOPES=openid email profile
# client_secret_basic (default) | client_secret_post
AR_OIDC_TOKEN_AUTH=client_secret_basic
AR_OIDC_ALLOWED_ALGS=RS256
AR_OIDC_CLOCK_SKEW_SEC=60
# Optional: where the IdP sends the browser after sign-out (must be registered with the IdP)
AR_OIDC_POST_LOGOUT_REDIRECT_URI=
# REQUIRED: PHI keyring (ADR 0080), also used to derive backup encryption keys.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AR_PHI_KEYS=
AR_PHI_ACTIVE_KEY_ID=
# REQUIRED: bearer token Prometheus uses for /metrics (at least 24 characters)
AR_METRICS_TOKEN=
# HTTP limits
AR_BODY_LIMIT_BYTES=1000000
AR_REQUEST_TIMEOUT_MS=30000
AR_HANDLER_TIMEOUT_MS=25000
AR_RATE_LIMIT_IP_PER_MIN=300
AR_RATE_LIMIT_KEY_PER_MIN=600
# REQUIRED: backups (encryption is mandatory outside synthetic)
AR_BACKUP_DIR=/backups
AR_BACKUP_INTERVAL_MINUTES=60
AR_BACKUP_KEEP=48
AR_BACKUP_ENCRYPT=on
AR_SHUTDOWN_GRACE_MS=15000
AR_LOG_LEVEL=info
# Worker: "off" in the API container when the worker runs separately (docker-compose.yml sets it)
# AR_WORKER=off
AR_WORKER_INTERVAL_MS=1500
AR_NOTIFY_INTERVAL_MS=5000
AR_GOVERNANCE_INTERVAL_MS=5000
